<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="VentasDetalladas" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="FECHA_DESDE" class="java.lang.String"/>
    <parameter name="FECHA_HASTA" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT v.id, c.nombre AS cliente, CAST(v.fecha AS VARCHAR) AS fecha,
                   a.codigo, a.descripcion, dv.precio,
                   COALESCE(dv.iva, a.iva, 10) AS iva, dv.cantidad,
                   COALESCE(dv.subtotal, dv.precio * dv.cantidad) AS subtotal
            FROM ventas v
            JOIN clientes c ON v.idcliente = c.id
            JOIN venta_detalle dv ON dv.idventa = v.id
            JOIN articulos a ON a.id = dv.idarticulo
            WHERE v.estado = 'FINALIZADO'
              AND ($P{FECHA_DESDE} IS NULL OR $P{FECHA_DESDE} = '' OR v.fecha >= CAST($P{FECHA_DESDE} AS DATE))
              AND ($P{FECHA_HASTA} IS NULL OR $P{FECHA_HASTA} = '' OR v.fecha <= CAST($P{FECHA_HASTA} AS DATE))
            ORDER BY v.id DESC, a.descripcion
        ]]>
    </queryString>

    <field name="id" class="java.lang.Integer"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="precio" class="java.math.BigDecimal"/>
    <field name="iva" class="java.math.BigDecimal"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="subtotal" class="java.math.BigDecimal"/>

    <variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
    </variable>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="20" y="10" width="555" height="25"/>
                <textElement textAlignment="Center"><font size="16" isBold="true"/></textElement>
                <text><![CDATA[CLIENTIX - VENTAS DETALLADAS]]></text>
            </staticText>
            <textField>
                <reportElement x="20" y="40" width="555" height="18"/>
                <textElement textAlignment="Center"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Periodo: " + ($P{FECHA_DESDE} == null || $P{FECHA_DESDE}.equals("") ? "Inicio" : $P{FECHA_DESDE}) + "  al  " + ($P{FECHA_HASTA} == null || $P{FECHA_HASTA}.equals("") ? "Hoy" : $P{FECHA_HASTA})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement x="20" y="2" width="40" height="16"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[N°]]></text></staticText>
            <staticText><reportElement x="60" y="2" width="100" height="16"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Cliente]]></text></staticText>
            <staticText><reportElement x="160" y="2" width="60" height="16"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement x="220" y="2" width="50" height="16"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
            <staticText><reportElement x="270" y="2" width="110" height="16"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Descripción]]></text></staticText>
            <staticText><reportElement x="380" y="2" width="50" height="16"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Precio]]></text></staticText>
            <staticText><reportElement x="430" y="2" width="35" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[IVA]]></text></staticText>
            <staticText><reportElement x="465" y="2" width="30" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Cant]]></text></staticText>
            <staticText><reportElement x="495" y="2" width="60" height="16"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Subtotal]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField><reportElement x="20" y="0" width="40" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
            <textField><reportElement x="60" y="0" width="100" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression></textField>
            <textField><reportElement x="160" y="0" width="60" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField>
            <textField><reportElement x="220" y="0" width="50" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField><reportElement x="270" y="0" width="110" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="380" y="0" width="50" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="430" y="0" width="35" height="14"/><textElement textAlignment="Center"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{iva}]]></textFieldExpression></textField>
            <textField><reportElement x="465" y="0" width="30" height="14"/><textElement textAlignment="Center"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement x="495" y="0" width="60" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="20" y="3" width="150" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
            <textField><reportElement x="400" y="3" width="155" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>

    <summary>
        <band height="25">
            <staticText><reportElement x="380" y="5" width="110" height="16"/><textElement textAlignment="Right"><font size="10" isBold="true"/></textElement><text><![CDATA[TOTAL:]]></text></staticText>
            <textField pattern="#,##0" evaluationTime="Report"><reportElement x="490" y="5" width="65" height="16"/><textElement textAlignment="Right"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>

