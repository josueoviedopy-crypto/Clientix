<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ClienteIndividual" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="ID" class="java.lang.Integer"/>

    <queryString>
        <![CDATA[
            SELECT id, nombre, documento, 
                   COALESCE(email, '') AS email, 
                   COALESCE(telefono, '') AS telefono
            FROM clientes 
            WHERE id = $P{ID}
        ]]>
    </queryString>

    <field name="id" class="java.lang.Integer"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="documento" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="50" y="10" width="455" height="30"/>
                <box>
                    <pen lineWidth="1.5"/>
                    <topPen lineWidth="1.5"/><leftPen lineWidth="1.5"/>
                    <bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE INDIVIDUAL DE CLIENTE]]></text>
            </staticText>

            <staticText>
                <reportElement x="50" y="50" width="150" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[CÓDIGO DEL CLIENTE:]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="50" width="100" height="20"/>
                <box>
                    <pen lineWidth="0.5"/><topPen lineWidth="0.5"/>
                    <leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/>
                </box>
                <textElement verticalAlignment="Middle"><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{ID}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="180">
            <rectangle>
                <reportElement x="50" y="20" width="455" height="150"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="70" y="40" width="120" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[NOMBRE:]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="40" width="280" height="20"/>
                <box><bottomPen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="70" y="70" width="120" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[DOCUMENTO:]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="70" width="280" height="20"/>
                <box><bottomPen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$F{documento}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="70" y="100" width="120" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[EMAIL:]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="100" width="280" height="20"/>
                <box><bottomPen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="70" y="130" width="120" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[TELÉFONO:]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="130" width="280" height="20"/>
                <box><bottomPen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="30" y="5" width="150" height="20"/>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="5" width="150" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
